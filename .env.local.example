NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Origine publique de l'app (sans slash final), utilisée pour construire le
# lien client partagé (ex. https://fillo.app ou https://ton-projet.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate limiting du formulaire client public (compte Upstash Redis gratuit).
# Si absent, aucune limite n'est appliquée (comportement de secours en dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
